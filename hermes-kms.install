# Warn about a stale /etc/modprobe.d override that masks the shipped default.

_hermes_kms_stale_override() {
  local conf=/etc/modprobe.d/hermes-kms.conf

  [ -f "$conf" ] || return 0
  grep -Eq '^[[:space:]]*options[[:space:]]+hermes_kms\b.*\binitial_enabled=1\b' "$conf" || return 0

  cat >&2 <<-EOF

  ==> WARNING: $conf sets initial_enabled=1
      This file overrides the default shipped in
      /usr/lib/modprobe.d/hermes-kms.conf and connects a virtual output at
      boot, before a consumer owns it. GNOME and KDE may extend the desktop onto
      a monitor that no client is streaming.

      Fix it with either of:
        sudo rm $conf
        sudo sed -i 's/initial_enabled=1/initial_enabled=0/' $conf

      Then reload the module or reboot.

	EOF
}

_runtime_reload() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
  fi
  if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=drm --action=change || true
  fi
}

_stop_brokers() {
  if command -v systemctl >/dev/null 2>&1; then
    # Keep the glob quoted for systemctl; the shell must not expand it.
    systemctl stop 'hermes-kms-seatd@*.service' 2>/dev/null || true
  fi
}

_remove_managed_access_rule() {
  local rule=/etc/udev/rules.d/90-hermes-kms-user.rules

  [ -f "$rule" ] || return 0
  grep -qx '# Managed by hermes-kms-setup. Grants one configured UID render-node access.' "$rule" || return 0
  rm -f -- "$rule"
}

_remove_managed_setup_state() {
  local modprobe=/etc/modprobe.d/hermes-kms.conf
  local modules=/etc/modules-load.d/hermes-kms.conf
  local session_user=/etc/hermes-kms/session-user

  _remove_managed_access_rule
  if [ -f "$modprobe" ] &&
     grep -qx '# Managed by hermes-kms-setup. Connectors stay disabled until owned.' "$modprobe"; then
    rm -f -- "$modprobe"
  fi
  if [ -f "$modules" ] && [ "$(cat "$modules")" = hermes_kms ]; then
    rm -f -- "$modules"
  fi
  if [ -f "$session_user" ] &&
     grep -Eq '^[0-9]+$' "$session_user" &&
     [ "$(wc -l <"$session_user")" -eq 1 ]; then
    rm -f -- "$session_user"
  fi
  rmdir /etc/hermes-kms 2>/dev/null || true
}

# Nothing owns the render nodes until hermes-kms-setup has run.
#
# 72-hermes-kms-session-seats.rules denies every Hermes render node by default,
# and 92- only reverses that for a card whose hermes_kms_access_uid is set -
# which no card in the packaged pool sets, host or session; the attribute is
# there and empty. The one thing that grants the consumer access is therefore
# the 90- rule hermes-kms-setup writes, and until it exists a loaded, healthy
# module reports itself as unusable: the consumer logs "Couldn't open render
# node ... Permission denied" and its panel says Hermes-KMS is not enabled,
# which sends people to modprobe a module that is already loaded.
#
# post_install always said to run the setup. An upgrade did not, and an upgrade
# is where somebody who removed and reinstalled - or who never ran it in the
# first place - ends up. Say it whenever it is actually missing.
_hermes_kms_missing_access_rule() {
  local rule=/etc/udev/rules.d/90-hermes-kms-user.rules

  [ -f "$rule" ] && return 1
  return 0
}

_hermes_kms_setup_hint() {
  _hermes_kms_missing_access_rule || return 0

  cat >&2 <<-EOF

  ==> Hermes-KMS render nodes are root-only until you configure a consumer.
      Nothing has granted a user access to them, so a loaded module will still
      report itself as unavailable, with "Permission denied" on /dev/dri/renderD*
      in the consumer's log.

      Configure it with:
        sudo /usr/lib/hermes-kms/hermes-kms-setup configure --user auto

	EOF
}

post_install() {
  _hermes_kms_stale_override
  _runtime_reload

  printf '%s\n' \
    'The Arch DKMS post-transaction hook will build Hermes-KMS for installed kernels.' \
    'After this transaction completes, load it with: sudo modprobe hermes_kms' \
    'Then configure broker/render-node ownership for the intended consumer:' \
    '  sudo /usr/lib/hermes-kms/hermes-kms-setup configure --user auto'
}

post_upgrade() {
  _hermes_kms_stale_override
  _runtime_reload

  if grep -q '^hermes_kms ' /proc/modules 2>/dev/null; then
    printf '%s\n' \
      'Hermes-KMS was upgraded while loaded; reboot before testing the new driver.'
  else
    printf '%s\n' \
      'The Arch DKMS post-transaction hook will finish the kernel builds.' \
      'After this transaction completes, load it with: sudo modprobe hermes_kms'
  fi

  _hermes_kms_setup_hint
}

pre_remove() {
  _stop_brokers
  _remove_managed_setup_state
  rm -rf -- /run/hermes-kms-seatd
}

post_remove() {
  _stop_brokers
  _runtime_reload
}
