# Warn about a stale /etc/modprobe.d override that masks the shipped default.
#
# The package installs its default to /usr/lib/modprobe.d/hermes-kms.conf, but
# /etc/modprobe.d takes precedence over /usr/lib/modprobe.d. Older packages -
# and older setup instructions - wrote initial_enabled=1 to
# /etc/modprobe.d/hermes-kms.conf, which connects a virtual output at boot,
# before Hermes owns it. Compositors adopt that connector and extend the desktop
# onto a monitor nobody streams to, which the user sees as a black screen.
#
# Upgrading cannot fix this by itself: the package does not own the file in
# /etc, so it can only report it.

_hermes_kms_stale_override() {
	local conf=/etc/modprobe.d/hermes-kms.conf

	[ -f "$conf" ] || return 0
	grep -Eq '^[[:space:]]*options[[:space:]]+hermes_kms\b.*\binitial_enabled=1\b' "$conf" || return 0

	cat >&2 <<-EOF

	==> WARNING: $conf sets initial_enabled=1
	    This file overrides the default shipped in
	    /usr/lib/modprobe.d/hermes-kms.conf and connects a virtual output at
	    boot, before Hermes owns it. GNOME and KDE will extend the desktop
	    onto a black monitor that no client is streaming.

	    Fix it with either of:
	      rm $conf
	      sed -i 's/initial_enabled=1/initial_enabled=0/' $conf

	    Then reload the module:
	      modprobe -r hermes_kms && modprobe hermes_kms

	EOF
}

post_install() {
	_hermes_kms_stale_override
}

post_upgrade() {
	_hermes_kms_stale_override
}
