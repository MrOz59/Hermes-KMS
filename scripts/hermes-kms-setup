#!/bin/sh
# Configure the packaged Hermes-KMS session pool for one non-root consumer.
set -eu

DEFAULT_SESSION_DEVICES=4
MAX_SESSION_DEVICES=8
MODPROBE_CONFIG=/etc/modprobe.d/hermes-kms.conf
MODULES_CONFIG=/etc/modules-load.d/hermes-kms.conf
SESSION_USER_FILE=/etc/hermes-kms/session-user
RUNTIME_ROOT=/run/hermes-kms-seatd
ACCESS_RULE=/etc/udev/rules.d/90-hermes-kms-user.rules

usage() {
	printf '%s\n' \
		"Usage: hermes-kms-setup configure --user UID|auto [--session-devices N]" \
		"" \
		"Configures one seat0 host card plus N private session cards for the selected UID." >&2
	exit 2
}

[ "${1:-}" = configure ] || usage
shift

TARGET_UID=
SESSION_DEVICES=$DEFAULT_SESSION_DEVICES
while [ "$#" -gt 0 ]; do
	case "$1" in
		--user)
			[ "$#" -ge 2 ] || usage
			TARGET_UID=$2
			shift 2
			;;
		--session-devices)
			[ "$#" -ge 2 ] || usage
			SESSION_DEVICES=$2
			shift 2
			;;
		*)
			usage
			;;
	esac
done

[ "$(id -u)" -eq 0 ] || {
	printf 'hermes-kms-setup must run as root (use pkexec or sudo)\n' >&2
	exit 1
}

if [ "$TARGET_UID" = auto ]; then
	TARGET_UID="${PKEXEC_UID:-${SUDO_UID:-}}"
fi
case "$TARGET_UID" in
	''|*[!0-9]*)
		printf 'a numeric --user UID is required (or use auto through sudo/pkexec)\n' >&2
		exit 2
		;;
esac
case "$SESSION_DEVICES" in
	1|2|3|4|5|6|7|8) ;;
	*) printf 'session device count must be 1-%s\n' "$MAX_SESSION_DEVICES" >&2; exit 2 ;;
esac
getent passwd "$TARGET_UID" >/dev/null || {
	printf 'uid %s does not identify a local user\n' "$TARGET_UID" >&2
	exit 2
}
command -v seatd >/dev/null || {
	printf 'seatd is required; install the seatd package first\n' >&2
	exit 3
}
command -v modprobe >/dev/null || {
	printf 'modprobe is required\n' >&2
	exit 3
}
command -v systemctl >/dev/null || {
	printf 'systemctl is required\n' >&2
	exit 3
}
command -v udevadm >/dev/null || {
	printf 'udevadm is required\n' >&2
	exit 3
}
if [ -L /etc/hermes-kms ]; then
	printf 'refusing symlink configuration directory: /etc/hermes-kms\n' >&2
	exit 3
fi
install -d -o root -g root -m 0755 \
	/etc/hermes-kms /etc/modprobe.d /etc/modules-load.d /etc/udev/rules.d

tmp_config=
tmp_user=
tmp_modules=
tmp_access_rule=
cleanup_tmp() {
	for tmp_file in "$tmp_config" "$tmp_user" "$tmp_modules" "$tmp_access_rule"; do
		[ -n "$tmp_file" ] && rm -f -- "$tmp_file"
	done
}
trap cleanup_tmp EXIT
trap 'exit 1' HUP INT TERM
tmp_config="$(mktemp "${MODPROBE_CONFIG}.XXXXXX")"
tmp_user="$(mktemp "${SESSION_USER_FILE}.XXXXXX")"
tmp_modules="$(mktemp "${MODULES_CONFIG}.XXXXXX")"
tmp_access_rule="$(mktemp "${ACCESS_RULE}.XXXXXX")"
{
	printf '%s\n' \
		'# Managed by hermes-kms-setup. Connectors stay disabled until owned.' \
		"# One host card remains on seat0; ${SESSION_DEVICES} private cards are pre-created." \
		"options hermes_kms initial_enabled=0 outputs=1 session_devices=${SESSION_DEVICES}"
} >"$tmp_config"
printf '%s\n' "$TARGET_UID" >"$tmp_user"
printf '%s\n' hermes_kms >"$tmp_modules"
{
	printf '%s\n' \
		'# Managed by hermes-kms-setup. Grants one configured UID render-node access.' \
		'# Numeric non-system OWNER is deprecated by udev; use is temporary until a managed group/ACL design replaces it.' \
		"ACTION==\"add|change\", SUBSYSTEM==\"drm\", KERNEL==\"renderD[0-9]*\", DEVPATH==\"*/platform/hermes-kms*/drm/renderD*\", OWNER=\"${TARGET_UID}\", GROUP=\"root\", MODE=\"0600\", TAG-=\"uaccess\""
} >"$tmp_access_rule"
chmod 0644 "$tmp_config" "$tmp_user" "$tmp_modules" "$tmp_access_rule"
mv -fT -- "$tmp_config" "$MODPROBE_CONFIG"
mv -fT -- "$tmp_user" "$SESSION_USER_FILE"
mv -fT -- "$tmp_modules" "$MODULES_CONFIG"
mv -fT -- "$tmp_access_rule" "$ACCESS_RULE"
tmp_config=
tmp_user=
tmp_modules=
tmp_access_rule=
trap - EXIT HUP INT TERM

# Repair the ownership left by launcher versions that made this common root
# writable by the session user. /run itself is root-owned, so this path cannot
# be replaced while its ownership and mode are corrected.
if [ -L "$RUNTIME_ROOT" ]; then
	printf 'refusing symlink runtime directory: %s\n' "$RUNTIME_ROOT" >&2
	exit 3
fi
if [ -d "$RUNTIME_ROOT" ]; then
	chown root:root "$RUNTIME_ROOT"
	chmod 0711 "$RUNTIME_ROOT"
fi

systemctl daemon-reload
udevadm control --reload-rules

# Older prototype instructions enabled broker instances permanently. Remove
# those enablement links for every supported slot; the role-aware DRM uevents
# now start exactly the brokers that correspond to private session cards.
instance=1
while [ "$instance" -le "$MAX_SESSION_DEVICES" ]; do
	systemctl disable "hermes-kms-seatd@${instance}.service" \
		>/dev/null 2>&1 || true
	instance=$((instance + 1))
done

if [ ! -d /sys/module/hermes_kms ]; then
	if ! modprobe hermes_kms; then
		printf 'failed to load hermes_kms; update the driver and check the kernel log\n' >&2
		exit 4
	fi
fi

if [ ! -r /sys/module/hermes_kms/parameters/session_devices ] ||
   [ ! -r /sys/module/hermes_kms/parameters/outputs ] ||
   [ ! -r /sys/module/hermes_kms/parameters/initial_enabled ]; then
	printf 'configuration saved; reboot required because the loaded Hermes-KMS driver predates automatic session pools\n'
	exit 10
fi

running_session_devices="$(cat /sys/module/hermes_kms/parameters/session_devices)"
running_outputs="$(cat /sys/module/hermes_kms/parameters/outputs)"
running_initial_enabled="$(cat /sys/module/hermes_kms/parameters/initial_enabled)"
if [ "$running_session_devices" != "$SESSION_DEVICES" ] ||
   [ "$running_outputs" != 1 ] ||
   { [ "$running_initial_enabled" != N ] && [ "$running_initial_enabled" != 0 ]; }; then
	printf '%s\n' \
		"configuration saved; reboot required (running session_devices=${running_session_devices}, requested=${SESSION_DEVICES}; running outputs=${running_outputs}, requested=1; running initial_enabled=${running_initial_enabled}, requested=0)"
	exit 10
fi

udevadm trigger --subsystem-match=drm --action=change
udevadm settle

# Stop stale brokers left by a previously larger pool. Desired instances are
# restarted below after udev has established their current device mapping.
instance=$((SESSION_DEVICES + 1))
while [ "$instance" -le "$MAX_SESSION_DEVICES" ]; do
	systemctl stop "hermes-kms-seatd@${instance}.service" || true
	instance=$((instance + 1))
done

instance=1
while [ "$instance" -le "$SESSION_DEVICES" ]; do
	systemctl restart "hermes-kms-seatd@${instance}.service"
	instance=$((instance + 1))
done

printf 'Hermes-KMS ready: user=%s session_devices=%s\n' \
	"$TARGET_UID" "$SESSION_DEVICES"
