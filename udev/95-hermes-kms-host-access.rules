# After all packaged deny rules, give only unassigned host/general render nodes
# to the active desktop seat. Keep the ACL mask read-only: Hermes-KMS control
# and capture ioctls work on an O_RDONLY fd, while Chromium/Electron probe GPU
# render nodes with O_RDWR and must not select this capture-only device.
# Ownership remains root:root; uaccess still selects the active desktop user.
# The helper runs after the uaccess builtin and masks its rw entry down to r--.
# Explicit access_uid cards and private session cards receive their ACL from the
# same helper through 72-hermes-kms-render-access.rules.
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="renderD[0-9]*", DEVPATH=="*/platform/hermes-kms*/drm/renderD*", ATTRS{hermes_kms_role}=="host", ATTRS{hermes_kms_access_uid}=="", OWNER="root", GROUP="root", MODE="0640", TAG+="uaccess", RUN{builtin}+="uaccess", RUN+="/usr/lib/hermes-kms/hermes-kms-render-acl %p"
# The legacy single static card has no numeric platform suffix. A configfs-only
# general card can also have index 0, but its path is hermes-kms.0 and must not
# gain seat0 access merely because its creator did not set access_uid.
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="renderD[0-9]*", DEVPATH=="*/platform/hermes-kms/drm/renderD*", ATTRS{hermes_kms_role}=="general", ATTRS{hermes_kms_access_uid}=="", OWNER="root", GROUP="root", MODE="0640", TAG+="uaccess", RUN{builtin}+="uaccess", RUN+="/usr/lib/hermes-kms/hermes-kms-render-acl %p"
