# Per-card render-node ACLs for cards created through configfs.
#
# A card created through configfs can name the UID it belongs to. The 72-
# rule's short-lived ACL helper grants that user access after udev has applied
# the final owner/mode. This rule removes the host's uaccess tag for a card
# with explicit access_uid so its seat cannot grant a second user access.
#
# A session card's primary node remains root-only and is reached through its
# private seat broker. An unknown UID remains denied by the ACL helper.
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="renderD[0-9]*", DEVPATH=="*/platform/hermes-kms*/drm/renderD*", ATTRS{hermes_kms_access_uid}=="?*", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess"
