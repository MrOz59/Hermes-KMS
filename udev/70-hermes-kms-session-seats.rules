# Assign only Hermes-KMS devices whose kernel identity says "session" to
# private seats. In the packaged session_devices=N pool, device 0 has role
# "host" and deliberately falls through to the normal seat0 rules. Explicit
# legacy devices=N layouts still mark every card as a session device.
#
# The matching private seatd broker is pulled in automatically by the DRM-card
# device. Users therefore do not need to enable N service instances manually.
# Keep the seat names synchronized with Hermes getHermesKmsSeatName().
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="1", ENV{ID_SEAT}="hermes-kms-1", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@1.service", GROUP="video", MODE="0660", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="2", ENV{ID_SEAT}="hermes-kms-2", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@2.service", GROUP="video", MODE="0660", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="3", ENV{ID_SEAT}="hermes-kms-3", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@3.service", GROUP="video", MODE="0660", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="4", ENV{ID_SEAT}="hermes-kms-4", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@4.service", GROUP="video", MODE="0660", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="5", ENV{ID_SEAT}="hermes-kms-5", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@5.service", GROUP="video", MODE="0660", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="6", ENV{ID_SEAT}="hermes-kms-6", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@6.service", GROUP="video", MODE="0660", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="7", ENV{ID_SEAT}="hermes-kms-7", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@7.service", GROUP="video", MODE="0660", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="8", ENV{ID_SEAT}="hermes-kms-8", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@8.service", GROUP="video", MODE="0660", TAG+="uaccess"

