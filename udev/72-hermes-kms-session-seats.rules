# The 72- prefix is load-bearing. systemd's 70-uaccess.rules unconditionally
# adds TAG+="uaccess" to every DRM card, and it sorts after any 70-hermes-*
# name, so a TAG-="uaccess" here at 70 was silently undone. 73-seat-late.rules
# then runs the uaccess builtin on whatever is still tagged, which is why this
# file has to land between the two.
#
# Assign only Hermes-KMS devices whose kernel identity says "session" to
# private seats. In the packaged session_devices=N pool, device 0 has role
# "host" and deliberately falls through to the normal seat0 rules. Explicit
# legacy devices=N layouts still mark every card as a session device.
#
# The matching private seatd broker is pulled in automatically by the DRM-card
# device. Users therefore do not need to enable N service instances manually.
# Consumers derive the seat name as hermes-kms-<session_index> from the
# stable UAPI/sysfs session index; no application-specific lookup is required.
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="1", ENV{ID_SEAT}="hermes-kms-1", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@1.service", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="2", ENV{ID_SEAT}="hermes-kms-2", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@2.service", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="3", ENV{ID_SEAT}="hermes-kms-3", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@3.service", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="4", ENV{ID_SEAT}="hermes-kms-4", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@4.service", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="5", ENV{ID_SEAT}="hermes-kms-5", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@5.service", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="6", ENV{ID_SEAT}="hermes-kms-6", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@6.service", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="7", ENV{ID_SEAT}="hermes-kms-7", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@7.service", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess"
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{hermes_kms_role}=="session", ATTRS{hermes_kms_session_index}=="8", ENV{ID_SEAT}="hermes-kms-8", TAG+="seat", TAG+="master-of-seat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hermes-kms-seatd@8.service", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess"

# Capture/control render nodes default to root-only access.
# hermes-kms-setup writes a generic UID-specific rule under /etc/udev/rules.d;
# do not grant every active local seat user access through uaccess.
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="renderD[0-9]*", DEVPATH=="*/platform/hermes-kms*/drm/renderD*", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess"
