[Unit]
Description=Hermes-KMS private seat broker for virtual device %i
Documentation=https://github.com/MrOz59/Hermes-KMS
After=systemd-udevd.service
Requires=systemd-udevd.service

[Service]
Type=simple
User=root
Group=seat
PrivateMounts=yes
RuntimeDirectory=hermes-kms-seatd/%i
RuntimeDirectoryMode=0750
ExecStart=/usr/lib/hermes-kms/hermes-kms-seatd-instance %i root seat
Restart=on-failure
RestartSec=1s

# seatd mediates DRM/input access and therefore intentionally needs root and
# unrestricted device access. Keep the remaining service surface small.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/hermes-kms-seatd/%i

[Install]
WantedBy=multi-user.target
