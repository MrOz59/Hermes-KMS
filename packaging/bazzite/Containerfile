# Layer Hermes-KMS into a Bazzite (or any bootc/ostree) image.
#
# Image-based distributions do not run DKMS: /usr is read-only at runtime, so
# there is no moment at which a module can be built on the installed system.
# The module is instead compiled against the image's kernel while the image is
# being built, and baked into /usr/lib/modules/<kver>/extra — the same place
# akmods and the ublue-os kmod images put theirs.
#
# Build:
#   podman build -t localhost/bazzite-hermes:latest -f packaging/bazzite/Containerfile .
#
# Rebase onto it:
#   sudo bootc switch --transport containers-storage localhost/bazzite-hermes:latest
#
# Push it somewhere and rebase from there instead if you want automatic updates.
#
# SECURE BOOT: Bazzite enables Secure Boot with the Universal Blue key. A module
# built here is unsigned, so the kernel refuses to load it while Secure Boot is
# on. Either enroll your own key and set MODULE_SIGN_KEY/MODULE_SIGN_CERT below,
# or turn Secure Boot off in firmware. There is no third option — an unsigned
# out-of-tree module and an enforcing Secure Boot cannot coexist.

ARG BASE_IMAGE=ghcr.io/ublue-os/bazzite
ARG BASE_TAG=latest

FROM ${BASE_IMAGE}:${BASE_TAG} AS build

# Sign the module with your own MOK. Both must be enrolled in firmware; leave
# them unset to build unsigned (then Secure Boot has to be off).
ARG MODULE_SIGN_KEY=""
ARG MODULE_SIGN_CERT=""

COPY . /src/hermes-kms

RUN set -eux; \
    # An ostree image carries exactly one kernel; take its version from the
    # module tree rather than uname, which reports the build host's kernel.
    kver="$(rpm -q --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}\n' kernel-core | head -n1)"; \
    test -d "/usr/lib/modules/${kver}" || kver="$(ls /usr/lib/modules | head -n1)"; \
    echo "building against kernel ${kver}"; \
    \
    rpm-ostree install -y \
    "kernel-devel-${kver}" \
    gcc make elfutils-libelf-devel openssl-devel; \
    \
    cd /src/hermes-kms; \
    make modules \
    KERNELRELEASE="${kver}" \
    KDIR="/usr/lib/modules/${kver}/build"; \
    \
    if [ -n "${MODULE_SIGN_KEY}" ] && [ -n "${MODULE_SIGN_CERT}" ]; then \
    echo "signing hermes_kms.ko"; \
    "/usr/lib/modules/${kver}/build/scripts/sign-file" \
    sha256 "${MODULE_SIGN_KEY}" "${MODULE_SIGN_CERT}" \
    kernel/hermes-kms/hermes_kms.ko; \
    else \
    echo "WARNING: hermes_kms.ko is unsigned; Secure Boot must be disabled to load it" >&2; \
    fi; \
    \
    make modules-install install-configs KERNELRELEASE="${kver}" DESTDIR=/; \
    \
    # The build toolchain and headers have no business in the shipped image.
    rpm-ostree uninstall -y \
    "kernel-devel-${kver}" \
    gcc make elfutils-libelf-devel openssl-devel; \
    rm -rf /src/hermes-kms; \
    \
    # Fail the build rather than ship an image whose module cannot be resolved.
    modinfo "/usr/lib/modules/${kver}/extra/hermes-kms/hermes_kms.ko" > /dev/null; \
    ostree container commit
